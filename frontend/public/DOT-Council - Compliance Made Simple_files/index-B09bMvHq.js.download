readAsDataURL(F)}),he=window.open("","_blank");if(C.current&&he){const ye=`
          <!DOCTYPE html>
          <html>
          <head>
            <title>UCR Registration Receipt</title>
            <style>
              @page {
                size: A4;
                margin: 0.5in;
              }
              body {
                font-family: 'Times New Roman', serif;
                margin: 0;
                padding: 0;
                background: white;
                font-size: 12px;
                line-height: 1.3;
                color: black;
                position: relative;
              }
              .receipt {
                width: 100%;
                max-width: 100%;
                background: white;
                position: relative;
                page-break-inside: avoid;
                min-height: 100vh;
              }
              /* Exact watermark matching webpage */
              .watermark-bg {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background-image: url('${oe}');
                background-repeat: no-repeat;
                background-position: center center;
                background-size: 500px 500px;
                opacity: 0.12;
                z-index: 1;
                pointer-events: none;
              }
              .content {
                position: relative;
                z-index: 10;
                padding: 20px;
                background: transparent;
              }
              /* Copy exact styles from webpage */
              .text-center { text-align: center; }
              .text-right { text-align: right; }
              .font-bold { font-weight: bold; }
              .mb-3 { margin-bottom: 12px; }
              .mb-15 { margin-bottom: 15px; }
              .mb-12 { margin-bottom: 12px; }
              .mb-2 { margin-bottom: 2px; }
              .mb-8 { margin-bottom: 8px; }
              .mb-5 { margin-bottom: 5px; }
              .ml-15 { margin-left: 15px; }
              .mt-20 { margin-top: 20px; }
              .p-5 { padding: 5px; }
              .p-8 { padding: 8px; }
              .border-black { border: 1px solid #000; }
              .border-2-black { border: 2px solid #000; }
              .bg-green { background-color: #90EE90; }
              .bg-gray { background-color: #f0f0f0; }
              .logo-top {
                text-align: center;
                margin-bottom: 12px;
              }
              .logo-top img {
                width: 60px;
                height: 60px;
                object-fit: contain;
              }
              .valid-banner {
                background-color: #90EE90;
                border: 2px solid #000;
                padding: 8px;
                margin: 0 0 15px 0;
                text-align: center;
                font-weight: bold;
                font-size: 14px;
              }
              table {
                width: 100%;
                border-collapse: collapse;
                margin: 8px 0;
                font-size: 11px;
              }
              th, td {
                border: 1px solid #000;
                padding: 4px 6px;
              }
              th {
                background-color: #f0f0f0;
                font-weight: bold;
              }
              .text-left { text-align: left; }
              .text-right { text-align: right; }
              .receipt-details {
                margin-bottom: 15px;
                font-size: 12px;
              }
              .detail-line {
                margin-bottom: 2px;
              }
              .section-spacing {
                margin-bottom: 12px;
                font-size: 11px;
              }
              .expiration-box {
                text-align: center;
                font-weight: bold;
                font-size: 12px;
                padding: 5px;
                border: 1px solid #000;
                margin-top: 20px;
              }
              @media print {
                body { margin: 0; padding: 0; }
                .no-print { display: none !important; }
                .receipt { height: auto !important; }
                .watermark-bg { 
                  position: fixed !important;
                  background-size: 500px 500px !important;
                  opacity: 0.12 !important;
                }
              }
            </style>
          </head>
          <body>
            <div class="watermark-bg"></div>
            <div class="receipt">
              <div class="content">
                <!-- Exact HTML structure from webpage -->
                <div class="logo-top">
                  <img src="${oe}" alt="Logo" />
                </div>

                <div class="valid-banner">
                  ${Ne} UCR Registration is VALID!
                </div>

                <div class="receipt-details">
                  <div class="detail-line"><strong>Receipt #</strong> ${ue}</div>
                  <div class="detail-line"><strong>Registered on:</strong> ${Le} ${W} EST</div>
                  <div class="detail-line"><strong>Generated:</strong> ${Le} ${W} EST</div>
                  <div style="margin-bottom: 8px;"><strong>Year:</strong> ${Ne}</div>
                </div>

                <div style="margin-bottom: 15px;">
                  <div style="font-weight: bold; margin-bottom: 5px;">Paid:</div>
                  <table>
                    <thead>
                      <tr class="bg-gray">
                        <th class="text-left">Date</th>
                        <th class="text-left">Bracket</th>
                        <th class="text-right">UCR Fee</th>
                        <th class="text-right">Conv. Fee</th>
                        <th class="text-right">Total</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>${Le}</td>
                        <td>Bracket ${Re} [${ne} veh.]</td>
